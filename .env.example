# ── FinMate environment variables ────────────────────────────────────────
# Copy this file to .env and fill in values. Everything below has a
# genuinely free/local default — no paid service is ever required.

# Local PostgreSQL (started via `docker compose up -d`, see docker-compose.yml)
DATABASE_URL="postgresql://finmate:finmate@localhost:5432/finmate?schema=public"

# Session / auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Cookie name used for the session token
SESSION_COOKIE_NAME="finmate_session"

# App URL (used for absolute links in emails, etc. — none required to run)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default currency shown across the app
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Demo mode: set to "true" to expose the /demo seeded read-only account
NEXT_PUBLIC_DEMO_MODE_ENABLED="true"

# Optional: only needed if you later wire in a real AI provider for
# Insights. FinMate's Insights Engine is fully rule-based and works
# with this left blank.
# AI_PROVIDER_API_KEY=
